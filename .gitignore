.DS_Store
Thumbs.db
__pycache__/
crates/python/python/pourpoint/_data/

# Compiled extension modules under any package directory, not just the current
# one: the shed/pyshed -> pourpoint rename (45c0582) left a 61 MB
# `pyshed/_pyshed.abi3.so` on disk that the package-specific patterns no longer
# matched, so it kept showing up as untracked.
crates/python/python/**/*.so
crates/python/python/**/*.dylib
crates/python/python/**/*.pyd

# Python build artifacts
crates/python/dist/

# Local benchmark output (written by scripts/bench-delineate.sh)
scratchpad/

# Archived PCE planning scaffolding (moved out of docs/; kept out of history)
/planning/

# MkDocs build output (written by `mkdocs build` / `make docs`)
/site/

# uv virtualenv created by the docs toolchain (`uv run` / `make docs`)
.venv/
